{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "JobTableRW",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:566667681926:table/trepo-recall-deep-dive"
    },
    {
      "Sid": "SelfInvokeAsyncWorker",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:566667681926:function:trepo-recall-deep-dive"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:566667681926:*"
    }
  ]
}
